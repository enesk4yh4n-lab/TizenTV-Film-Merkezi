  "releaseNotes": {
    "version": "2.1.15",
    "tr": [
      "İlk kurulumda Tümünü yükle seçildiğinde eklentiler toplu ön tarama beklemeden sırayla indirilir.",
      "Hazır olan eklentilerle devam edebilir, kalanları daha sonra yeniden deneyebilirsiniz.",
      "Tizen 6.5 için imzalı eklenti bağlantıları mevcut uygulama paketiyle açılır.",
      "HTML5 oynatıcı ilk kare hazır olana kadar bekler.",
      "Tizen 6.0'da KSD kaynaklarının video parçaları ve sarma için bekleme süresi ayarlandı."
    ],
    "en": [
      "Install all in first setup starts each plugin download without a bulk pre-scan.",
      "Continue with ready plugins and retry the remaining ones later.",
      "Signed plugin connections work on Tizen 6.5 with the existing application package.",
      "The HTML5 player waits until the first frame is ready.",
      "On Tizen 6.0, KSD playback waits longer for media segments and seeking."
    ]
  },
